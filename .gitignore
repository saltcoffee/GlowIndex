# ── 本地密钥：绝不提交 ─────────────────────────────────────────
.dev.vars
.dev.vars.*
# 模板必须提交，否则别人 clone 后不知道要配哪些变量
!.dev.vars.example

# 通用环境变量文件（万一以后接别的工具）
.env
.env.*
!.env.example

# 证书 / 私钥
*.pem
*.key
*.crt
*.p12

# ── 依赖与构建产物 ────────────────────────────────────────────
node_modules/

# 打包产物：npm run build 一条命令即可重建，没必要入库
dist/

# Wrangler 的本地状态与类型生成
.wrangler/
worker-configuration.d.ts

# npm 缓存（本机调试时用过）
.npm-cache/

# ── 测试与覆盖率 ──────────────────────────────────────────────
coverage/
.nyc_output/

# ── 系统 / 编辑器 ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# ── 临时文件 ──────────────────────────────────────────────────
*.log
*.tmp
*.swp
tmp-*
